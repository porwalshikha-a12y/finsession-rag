# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Required: your OpenAI API key (platform.openai.com -> API keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: point at any OpenAI-compatible endpoint instead of OpenAI
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional: overrides vector_store.dsn in config.yaml
# PGVECTOR_DSN=postgresql:///finsession
